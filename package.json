{
  "name": "budae-kiugi",
  "version": "0.83.13",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node tools/install-server-dependencies.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "pretest": "node tools/prepare-server.mjs",
    "test": "node --test tests/*.test.js",
    "audio:verify": "node tools/verify-audio.mjs",
    "build:release": "npm run audio:verify && npm run build",
    "android:sync": "npm run build:release && cap sync android",
    "qa:save": "vite --config tools/save-qa.config.mjs",
    "privacy:doc": "node tools/privacy-doc.mjs",
    "docs:personal": "node tools/personal-guide.mjs",
    "qa:personal": "vite --config tools/personal-qa.config.mjs",
    "qa:marshal": "vite --config tools/marshal-qa.config.mjs",
    "android:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android-build.ps1 -Mode Doctor",
    "android:key": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android-build.ps1 -Mode NewKey",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android-build.ps1 -Mode Debug",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android-build.ps1 -Mode Release",
    "balance:simulate": "node tools/growth-sim.mjs",
    "android:unsigned": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android-build.ps1 -Mode Unsigned",
    "qa:command": "vite --config tools/command-qa.config.mjs",
    "qa:potions": "vite --config tools/potion-qa.config.mjs",
    "qa:auto-tap": "vite --config tools/auto-tap-qa.config.mjs",
    "dev:firebase": "vite --host 127.0.0.1 --port 4196 --strictPort --mode firebase-dev",
    "build:firebase": "vite build --mode firebase-dev",
    "android:sync:firebase": "npm run build:firebase && cap sync android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
