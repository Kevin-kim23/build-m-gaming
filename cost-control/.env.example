# Copy to .env.budae-kiugi-dev locally. Never commit real billing identifiers.
COST_GUARD_PROJECT_NUMBER=REPLACE_WITH_PROJECT_NUMBER
COST_GUARD_BILLING_ACCOUNT=REPLACE_WITH_BILLING_ACCOUNT
COST_GUARD_BUDGET_ID=REPLACE_WITH_BUDGET_ID
COST_GUARD_RUNTIME_ACCOUNT=budget-cost-guard@budae-kiugi-dev.iam.gserviceaccount.com
# First deployment must observe only. Enforce after live read-only validation.
COST_GUARD_MODE=observe
